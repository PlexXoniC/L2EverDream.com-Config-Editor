<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>L2EverdreamConfig</AssemblyName>
    <Product>L2Everdream Config</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!--
    Release always publishes one L2EverdreamConfig.exe (no installer, no side files).
    Standalone (default): `dotnet publish -c Release` bundles .NET, so nothing else is needed.
    Needs-dotnet: publish with SelfContained=false for a much smaller exe that uses the installed .NET 10 Desktop Runtime.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Compression is only possible when .NET is bundled. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(SelfContained)' == 'true'">
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\L2Config.Core\L2Config.Core.csproj" />
  </ItemGroup>

  <!-- The catalog travels inside the exe. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\catalog\catalog.json" Link="catalog.json" LogicalName="catalog.json" />
    <EmbeddedResource Include="..\..\catalog\custom-config.json" Link="custom-config.json" LogicalName="custom-config.json" />
  </ItemGroup>

</Project>
