                    </Grid>
                    <TextBlock Text="{Binding Intro}" Style="{StaticResource CaptionText}" FontSize="13" Margin="0,6,0,0" LineHeight="19"
                               Visibility="{Binding IsFullMode, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
