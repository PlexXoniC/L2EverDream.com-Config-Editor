        <!-- ===== Skill durations page ======================================================== -->
        <DataTemplate DataType="{x:Type vm:SkillDurationRowViewModel}">
            <Border x:Name="Card" Margin="0,0,14,6" Padding="14,9" CornerRadius="11" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource SoftVioletHairBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="220" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <WrapPanel>
                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource StarlightBrush}" VerticalAlignment="Center" />
                            <Border x:Name="KindBadge" Style="{StaticResource Badge}" Background="{StaticResource ArcaneWashBrush}" BorderBrush="#739D8CF0">
                                <TextBlock x:Name="KindText" Text="{Binding KindWord}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ArcaneBrush}" />
                            </Border>
                        </WrapPanel>
                        <TextBlock FontSize="11.5" Foreground="{StaticResource CaptionBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding IdText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding UsedBy, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="NORMAL DURATION" Style="{StaticResource KickerText}" />
                        <TextBlock Text="{Binding DefaultText}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{StaticResource SoftTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding EnchantText}" FontSize="11" Foreground="{StaticResource DimLabelBrush}" TextWrapping="Wrap" Visibility="{Binding EnchantText, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="150">
                                <TextBox x:Name="Box" Style="{StaticResource FieldTextBox}" FontFamily="{StaticResource MonoFont}" TextAlignment="Right"
                                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, Delay=250}" AutomationProperties.Name="{Binding Name}"
                                         ToolTip="Type a duration such as 90s, 20m, 1h 30m or 1:30:00. Leave empty for the normal duration." />
                                <TextBlock Text="normal" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" IsHitTestVisible="False"
                                           Foreground="{StaticResource DimLabelBrush}" Visibility="{Binding Text, ElementName=Box, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                            </Grid>
                            <Button Style="{StaticResource LinkButton}" Content="↺ Normal" Command="{Binding ResetCommand}" Margin="6,0,0,0" VerticalAlignment="Center"
                                    ToolTip="Use the skill's normal duration (removes it from the list)" />
                        </StackPanel>
                        <TextBlock Text="{Binding PreviewText}" FontSize="11.5" Foreground="{StaticResource EmberBrush}" Margin="2,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding PreviewText, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Text="{Binding Error}" FontSize="11.5" Foreground="{StaticResource LanternBrush}" Margin="2,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasError, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDebuff}" Value="True">
                    <Setter TargetName="KindBadge" Property="Background" Value="Transparent" />
                    <Setter TargetName="KindBadge" Property="BorderBrush" Value="#4D7C6FB0" />
                    <Setter TargetName="KindText" Property="Foreground" Value="{StaticResource LabelBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource LanternHairBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource LanternBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SkillDurationsViewModel}">
            <Grid Margin="24,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,24,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource GhostButton}" Content="← Back to settings" Command="{Binding CloseCommand}" Padding="12,6" FontSize="12" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏳" FontSize="20" Foreground="{StaticResource ArcaneBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource StarlightBrush}" />
