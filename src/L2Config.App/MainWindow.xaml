                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <WrapPanel VerticalAlignment="Center">
                        <RadioButton Style="{StaticResource FilterRadio}" GroupName="SkillFilter" IsChecked="{Binding IsPlayersFilter, Mode=OneWay}" Command="{Binding FilterCommand}" CommandParameter="players"
                                     ToolTip="Buffs, songs and dances players learn or get from the buffer NPC">
                            <TextBlock Text="{Binding PlayersCount, StringFormat=Player and buffer buffs ({0})}" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource FilterRadio}" GroupName="SkillFilter" IsChecked="{Binding IsSongsFilter, Mode=OneWay}" Command="{Binding FilterCommand}" CommandParameter="songs">
                            <TextBlock Text="{Binding SongsCount, StringFormat=Songs and dances ({0})}" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource FilterRadio}" GroupName="SkillFilter" IsChecked="{Binding IsDebuffsFilter, Mode=OneWay}" Command="{Binding FilterCommand}" CommandParameter="debuffs">
                            <TextBlock Text="{Binding DebuffsCount, StringFormat=Debuffs ({0})}" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource FilterRadio}" GroupName="SkillFilter" IsChecked="{Binding IsNpcFilter, Mode=OneWay}" Command="{Binding FilterCommand}" CommandParameter="npc">
                            <TextBlock Text="{Binding NpcCount, StringFormat=NPC and monster skills ({0})}" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource FilterRadio}" GroupName="SkillFilter" IsChecked="{Binding IsChangedFilter, Mode=OneWay}" Command="{Binding FilterCommand}" CommandParameter="changed">
                            <TextBlock Text="{Binding ChangedCount, StringFormat=Custom duration ({0})}" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource FilterRadio}" GroupName="SkillFilter" IsChecked="{Binding IsAllFilter, Mode=OneWay}" Command="{Binding FilterCommand}" CommandParameter="all">
                            <TextBlock Text="{Binding AllCount, StringFormat=All ({0})}" />
                        </RadioButton>
                    </WrapPanel>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="SkillSearch" Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" AutomationProperties.Name="Search skills" />
                        <TextBlock Text="⌕" Margin="11,0,0,1" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource LabelBrush}" IsHitTestVisible="False" />
                        <TextBlock Text="Search skills by name or ID…" Margin="31,0,0,0" VerticalAlignment="Center" FontSize="13" IsHitTestVisible="False" Foreground="{StaticResource DimLabelBrush}"
                                   Visibility="{Binding Text, ElementName=SkillSearch, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                    </Grid>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Reading the skill list…" Style="{StaticResource CaptionText}" FontSize="13.5" Margin="2,20,0,0" Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhen}}" />
