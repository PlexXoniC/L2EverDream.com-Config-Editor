                        </Border>
                        <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="{StaticResource EmberBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding UnknownText, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="{Binding UnknownText}" FontSize="12.5" Foreground="{StaticResource LanternBrush}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="720" />
                            <Button Style="{StaticResource LinkButton}" Content="Remove them from the list" Command="{Binding RemoveUnknownCommand}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding UnreadableText}" FontSize="12.5" Foreground="{StaticResource LanternBrush}" TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="900" HorizontalAlignment="Left"
