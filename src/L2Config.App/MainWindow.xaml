                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                             KeyboardNavigation.TabNavigation="Continue" Visibility="{Binding HasVisible, Converter={StaticResource VisibleWhen}}" />

                    <Border Grid.Column="2" Padding="16,14" CornerRadius="14" Background="{StaticResource CardGradientBrush}" BorderBrush="{StaticResource VioletHairBrush}" BorderThickness="1"
                            Margin="0,0,14,10" VerticalAlignment="Top">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="Set many at once" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource StarlightBrush}" />
                            <TextBlock Text="{Binding ShownText, StringFormat=Applies to the {0} in the list (use the filters and search to choose them).}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="17" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="2× normal" Command="{Binding BulkCommand}" CommandParameter="x2" Padding="10,5" FontSize="12" Margin="0,0,6,6" />
