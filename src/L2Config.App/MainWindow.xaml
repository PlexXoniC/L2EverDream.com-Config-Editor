<Window x:Class="L2Config.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:L2Config.App.Infrastructure"
        xmlns:vm="clr-namespace:L2Config.App.ViewModels"
        Title="L2Everdream Config"
        Width="1280" Height="820" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource DeepBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource StarlightBrush}"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <infra:VisibleWhenConverter x:Key="VisibleWhen" />

        <!-- ===== Editors ===================================================================== -->
        <DataTemplate x:Key="ToggleEditor" DataType="{x:Type vm:SettingViewModel}">
            <ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="{Binding BoolValue, Mode=TwoWay}" HorizontalAlignment="Left"
                          AutomationProperties.Name="{Binding Name}" />
        </DataTemplate>

        <DataTemplate x:Key="NumberEditor" DataType="{x:Type vm:SettingViewModel}">
            <StackPanel Orientation="Horizontal">
                <TextBox Style="{StaticResource FieldTextBox}" Width="150" TextAlignment="Right" FontFamily="{StaticResource MonoFont}"
                         infra:NumericInput.ValueType="{Binding Definition.ValueType}"
                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{Binding Name}" />
                <TextBlock Text="{Binding Unit}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource LabelBrush}" FontSize="12.5" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SliderEditor" DataType="{x:Type vm:SettingViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider Minimum="{Binding Definition.Min}" Maximum="{Binding Definition.Max}" Value="{Binding NumberValue, Mode=TwoWay}"
                        SmallChange="1" LargeChange="10" IsSnapToTickEnabled="False" VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding Name}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <TextBox Style="{StaticResource FieldTextBox}" Width="70" TextAlignment="Right" FontFamily="{StaticResource MonoFont}"
                             infra:NumericInput.ValueType="{Binding Definition.ValueType}"
                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding Unit}" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource LabelBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ChoiceEditor" DataType="{x:Type vm:SettingViewModel}">
            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption, Mode=TwoWay}" DisplayMemberPath="Label"
                      AutomationProperties.Name="{Binding Name}" />
        </DataTemplate>

        <DataTemplate x:Key="TextEditor" DataType="{x:Type vm:SettingViewModel}">
            <StackPanel Orientation="Horizontal">
                <TextBox Style="{StaticResource FieldTextBox}" MinWidth="220" MaxWidth="340" TextWrapping="Wrap"
                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Name}" />
                <TextBlock Text="{Binding Unit}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource LabelBrush}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SecretEditor" DataType="{x:Type vm:SettingViewModel}">
            <PasswordBox Width="220" HorizontalAlignment="Left" infra:PasswordBinding.Value="{Binding Value, Mode=TwoWay}"
                         AutomationProperties.Name="{Binding Name}" />
        </DataTemplate>

        <DataTemplate x:Key="ReadOnlyEditor" DataType="{x:Type vm:SettingViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding Value}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{StaticResource LabelBrush}"
                           TextWrapping="Wrap" Visibility="{Binding IsMissing, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                <TextBlock Text="{Binding MissingText}" Style="{StaticResource CaptionText}" Foreground="{StaticResource LanternBrush}"
                           Visibility="{Binding MissingText, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SkillDurationsEditor" DataType="{x:Type vm:SettingViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding EditorSummary}" FontSize="12.5" Foreground="{StaticResource SoftTextBrush}" TextWrapping="Wrap" />
                <Button Style="{StaticResource GhostButton}" Content="Edit skill durations…" Command="{Binding OpenEditorCommand}" HorizontalAlignment="Left"
                        Padding="14,6" FontSize="12.5" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding EditorBlockedText, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding EditorBlockedText}" FontSize="12" Foreground="{StaticResource LanternBrush}" TextWrapping="Wrap" MaxWidth="290" VerticalAlignment="Center" />
                    <Button Style="{StaticResource LinkButton}" Content="Show →" Command="{Binding ShowGateCommand}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <infra:SettingEditorSelector x:Key="EditorSelector"
                                     Toggle="{StaticResource ToggleEditor}" Number="{StaticResource NumberEditor}"
                                     Slider="{StaticResource SliderEditor}" Choice="{StaticResource ChoiceEditor}"
                                     Text="{StaticResource TextEditor}" Secret="{StaticResource SecretEditor}"
                                     ReadOnly="{StaticResource ReadOnlyEditor}" SkillDurations="{StaticResource SkillDurationsEditor}" />

        <!-- ===== A setting row ================================================================ -->
        <DataTemplate DataType="{x:Type vm:SettingViewModel}">
            <Border x:Name="Card" Margin="0,0,14,8" Padding="16,12" CornerRadius="12" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource SoftVioletHairBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="260" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource StarlightBrush}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Border x:Name="StateBadge" Style="{StaticResource Badge}" Background="{StaticResource ArcaneWashBrush}"
                                    BorderBrush="#739D8CF0" Visibility="{Binding StateWord, Converter={StaticResource VisibleWhen}}">
                                <TextBlock x:Name="StateText" Text="{Binding StateWord}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ArcaneBrush}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="{StaticResource LanternWashBrush}" BorderBrush="{StaticResource LanternHairBrush}"
                                    Visibility="{Binding IsManaged, Converter={StaticResource VisibleWhen}}"
                                    ToolTip="{Binding Definition.ManagedReason}">
                                <TextBlock Text="🔒 Set by the launcher" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource EmberBrush}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="Transparent" BorderBrush="#4D7C6FB0"
                                    Visibility="{Binding Definition.Advanced, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Text="Advanced" FontSize="10" Foreground="{StaticResource DimLabelBrush}" />
                            </Border>
                        </WrapPanel>

                        <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" LineHeight="17"
                                   Visibility="{Binding HasDescription, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Text="{Binding Definition.ManagedReason}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                   Foreground="{StaticResource EmberBrush}" Visibility="{Binding IsManaged, Converter={StaticResource VisibleWhen}}" />

                        <ItemsControl ItemsSource="{Binding Relations}" Margin="0,6,0,0" Focusable="False"
                                      Visibility="{Binding HasRelations, Converter={StaticResource VisibleWhen}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RelationViewModel}">
                                    <Border x:Name="Line" Margin="0,3,0,0" Padding="9,5" CornerRadius="8" Background="{StaticResource ArcaneWashBrush}"
                                            BorderBrush="{StaticResource SoftVioletHairBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="Kicker" Text="{Binding Kicker}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource LabelBrush}" />
                                                <TextBlock x:Name="Body" Text="{Binding Text}" FontSize="12" Foreground="{StaticResource SoftTextBrush}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="Show →" Command="{Binding ShowCommand}"
                                                    VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="{Binding OtherName}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                            <Setter TargetName="Line" Property="Background" Value="{StaticResource LanternWashBrush}" />
                                            <Setter TargetName="Line" Property="BorderBrush" Value="{StaticResource LanternHairBrush}" />
                                            <Setter TargetName="Kicker" Property="Foreground" Value="{StaticResource LanternBrush}" />
                                            <Setter TargetName="Body" Property="Foreground" Value="{StaticResource EmberBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <WrapPanel Margin="0,8,0,0">
                            <Border CornerRadius="6" Background="#40100E22" BorderBrush="{StaticResource SoftVioletHairBrush}" BorderThickness="1" Padding="7,2"
                                    ToolTip="The real file and setting name this value is saved to.">
                                <TextBlock Text="{Binding Location}" Style="{StaticResource MonoChipText}" />
                            </Border>
                            <TextBlock Text="{Binding DefaultText}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11.5"
                                       Foreground="{StaticResource DimLabelBrush}" />
                            <TextBlock Text="{Binding RangeText}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11.5"
                                       Foreground="{StaticResource DimLabelBrush}" Visibility="{Binding RangeText, Converter={StaticResource VisibleWhen}}" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource EditorSelector}" Focusable="False" />
                        <TextBlock Text="{Binding Error}" Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource LanternBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding HasError, Converter={StaticResource VisibleWhen}}" />
                        <StackPanel Orientation="Horizontal" Margin="-4,4,0,0">
                            <Button Style="{StaticResource LinkButton}" Content="↶ Undo" Command="{Binding UndoCommand}" ToolTip="Put back the value that is in the file" />
                            <Button Style="{StaticResource LinkButton}" Content="↺ Reset to default" Command="{Binding ResetToDefaultCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource LanternHairBrush}" />
                    <Setter TargetName="Card" Property="Background" Value="#662A2350" />
                    <Setter TargetName="StateBadge" Property="Background" Value="{StaticResource LanternWashBrush}" />
                    <Setter TargetName="StateBadge" Property="BorderBrush" Value="{StaticResource LanternHairBrush}" />
                    <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource EmberBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource LanternBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== A group heading in the settings list ======================================== -->
        <DataTemplate DataType="{x:Type vm:GroupHeaderRow}">
            <StackPanel Margin="2,18,14,10">
                <TextBlock Text="{Binding Breadcrumb}" Style="{StaticResource KickerText}" Margin="0,0,0,2"
                           Visibility="{Binding Breadcrumb, Converter={StaticResource VisibleWhen}}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource StarlightBrush}" />
                    <TextBlock Text="{Binding Count, StringFormat={}{0} settings}" Margin="12,0,0,2" VerticalAlignment="Bottom" FontSize="11.5"
                               Foreground="{StaticResource DimLabelBrush}" />
                </StackPanel>
                <Border Height="1" Margin="0,8,0,0" Background="{StaticResource SoftVioletHairBrush}" />
            </StackPanel>
        </DataTemplate>

        <!-- ===== Custom Config tab (read-only) ================================================ -->
        <Style x:Key="FilterRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="{StaticResource ArcaneWashBrush}" BorderBrush="#4D7C6FB0" BorderThickness="1" CornerRadius="9" Padding="11,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource VioletHairHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SelectedWashBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ArcaneBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource StarlightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ValueColumn">
            <StackPanel Margin="0,0,22,0">
                <TextBlock Text="{Binding Label}" Style="{StaticResource KickerText}" />
                <TextBlock Text="{Binding Value}" FontFamily="{StaticResource MonoFont}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="260"
                           Foreground="{Binding Brush}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CustomChangeViewModel}">
            <Border Margin="0,0,14,10" Padding="18,14" CornerRadius="12" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource SoftVioletHairBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource StarlightBrush}" VerticalAlignment="Center" />
                            <Border x:Name="KindBadge" Style="{StaticResource Badge}" Background="{StaticResource ArcaneWashBrush}" BorderBrush="#739D8CF0">
                                <TextBlock x:Name="KindText" Text="{Binding KindWord}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ArcaneBrush}" />
                            </Border>
                        </WrapPanel>
                        <Border CornerRadius="6" Background="#40100E22" BorderBrush="{StaticResource SoftVioletHairBrush}" BorderThickness="1" Padding="7,2"
                                Margin="0,6,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Location}" Style="{StaticResource MonoChipText}" />
                        </Border>
                        <TextBlock Text="{Binding Note}" Style="{StaticResource CaptionText}" FontSize="13" LineHeight="19" Margin="0,10,0,0"
                                   Foreground="{StaticResource BodyTextBrush}" Visibility="{Binding Note, Converter={StaticResource VisibleWhen}}" />
                        <WrapPanel Margin="0,12,0,0">
                            <StackPanel Margin="0,0,26,0">
                                <TextBlock Text="STOCK L2J MOBIUS" Style="{StaticResource KickerText}" />
                                <TextBlock Text="{Binding StockText}" FontFamily="{StaticResource MonoFont}" FontSize="13" Margin="0,3,0,0" MaxWidth="280" TextWrapping="Wrap"
                                           Foreground="{StaticResource CaptionBrush}" />
                            </StackPanel>
                            <TextBlock Text="→" FontSize="16" Foreground="{StaticResource DimLabelBrush}" VerticalAlignment="Bottom" Margin="0,0,26,0" />
                            <StackPanel Margin="0,0,26,0">
                                <TextBlock Text="L2EVERDREAM SHIPS" Style="{StaticResource KickerText}" />
                                <TextBlock Text="{Binding ShippedText}" FontFamily="{StaticResource MonoFont}" FontSize="13" Margin="0,3,0,0" MaxWidth="280" TextWrapping="Wrap"
                                           Foreground="{StaticResource EmberBrush}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="YOUR FILE NOW" Style="{StaticResource KickerText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding CurrentText}" FontFamily="{StaticResource MonoFont}" FontSize="13" MaxWidth="280" TextWrapping="Wrap"
                                               Foreground="{StaticResource StarlightBrush}" />
                                    <TextBlock Text="  (you changed this)" FontSize="12" Foreground="{StaticResource ArcaneBrush}"
                                               Visibility="{Binding DiffersFromShipped, Converter={StaticResource VisibleWhen}}" />
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Show in editor" Padding="12,6" FontSize="12"
                            VerticalAlignment="Top" Margin="16,0,0,0" Command="{Binding ShowCommand}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAdded}" Value="True">
                    <Setter TargetName="KindBadge" Property="Background" Value="{StaticResource LanternWashBrush}" />
                    <Setter TargetName="KindBadge" Property="BorderBrush" Value="{StaticResource LanternHairBrush}" />
                    <Setter TargetName="KindText" Property="Foreground" Value="{StaticResource EmberBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Characters tab (live world database) ======================================= -->
        <DataTemplate DataType="{x:Type vm:CharacterRowViewModel}">
            <Border x:Name="Card" Margin="0,0,14,8" Padding="16,12" CornerRadius="12" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource SoftVioletHairBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="240" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="400" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource StarlightBrush}" VerticalAlignment="Center" />
                            <Border x:Name="StatusBadge" Style="{StaticResource Badge}" Background="Transparent" BorderBrush="#4D7C6FB0">
                                <TextBlock x:Name="StatusText" Text="{Binding StatusWord}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource LabelBrush}" />
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Details}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding CurrentAdenaText}" FontFamily="{StaticResource MonoFont}" FontSize="13" Margin="0,8,0,0"
                                   Foreground="{StaticResource EmberBrush}" />
                        <TextBlock Text="{Binding LockReason}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" Foreground="{StaticResource LanternBrush}"
                                   Visibility="{Binding LockReason, Converter={StaticResource VisibleWhen}}" />
                        <Button Style="{StaticResource GhostButton}" Content="Inventory…" Command="{Binding OpenInventoryCommand}" HorizontalAlignment="Left"
                                Padding="14,5" FontSize="12" Margin="0,10,0,0" ToolTip="See, change, remove and add items" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Visibility="{Binding CanEdit, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="ADENA IN INVENTORY" Style="{StaticResource KickerText}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Style="{StaticResource FieldTextBox}" Width="170" TextAlignment="Right" FontFamily="{StaticResource MonoFont}"
                                     infra:NumericInput.ValueType="Int" Text="{Binding AdenaText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{Binding Name}" />
                            <Button Style="{StaticResource GhostButton}" Content="Apply" Command="{Binding ApplyCommand}" Margin="10,0,0,0" Padding="16,6" />
                        </StackPanel>
                        <TextBlock Text="{Binding RangeText}" FontSize="11.5" Foreground="{StaticResource DimLabelBrush}" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding Error}" FontSize="12" Foreground="{StaticResource LanternBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{StaticResource LanternBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Message, Converter={StaticResource VisibleWhen}}" />
                        <Button Style="{StaticResource LinkButton}" Content="↶ Undo" Command="{Binding UndoCommand}" HorizontalAlignment="Left" Margin="-4,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                    <Setter TargetName="StatusBadge" Property="BorderBrush" Value="{StaticResource VerdanceBrush}" />
                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource VerdanceBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource LanternHairBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Inventory editor ============================================================ -->
        <DataTemplate DataType="{x:Type vm:InventoryRowViewModel}">
            <Border Margin="0,0,0,6" Padding="14,9" CornerRadius="10" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource SoftVioletHairBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource StarlightBrush}" />
                        <TextBlock Text="{Binding Details}" FontSize="11.5" Foreground="{StaticResource CaptionBrush}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding CountError}" FontSize="11.5" Foreground="{StaticResource LanternBrush}" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding CountError, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CountDisplay}" FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{StaticResource EmberBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                   Visibility="{Binding CanEditCount, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding CanEditCount, Converter={StaticResource VisibleWhen}}">
                            <TextBox Style="{StaticResource FieldTextBox}" Width="130" TextAlignment="Right" FontFamily="{StaticResource MonoFont}"
                                     infra:NumericInput.ValueType="Int" Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding DisplayName}" />
                            <Button Style="{StaticResource GhostButton}" Content="Set count" Command="{Binding ApplyCommand}" Margin="8,0,0,0" Padding="12,5" FontSize="12" />
                        </StackPanel>
                        <Button Style="{StaticResource GhostButton}" Content="Remove" Command="{Binding RemoveCommand}" Margin="8,0,0,0" Padding="12,5" FontSize="12"
                                Visibility="{Binding CanEdit, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DeliveryRowViewModel}">
            <Border Margin="0,0,0,6" Padding="14,8" CornerRadius="10" Background="{StaticResource LanternWashBrush}" BorderBrush="{StaticResource LanternHairBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Text}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource EmberBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding When}" FontSize="11.5" Foreground="{StaticResource CaptionBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Cancel delivery" Command="{Binding CancelCommand}" Padding="12,5" FontSize="12" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="2,0,24,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource GhostButton}" Content="← All characters" Command="{Binding CloseCommand}" Padding="12,6" FontSize="12" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource StarlightBrush}" />
                            <Border Style="{StaticResource Badge}" Background="Transparent" BorderBrush="#4D7C6FB0" Margin="10,4,0,0">
                                <TextBlock Text="{Binding StatusWord}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource LabelBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding SlotsText}" FontSize="12.5" Foreground="{StaticResource EmberBrush}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding LimitSourceText}" FontSize="11.5" Foreground="{StaticResource DimLabelBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="↻ Refresh" Command="{Binding RefreshCommand}" Padding="14,6" FontSize="12" VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="430" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Problem}" Style="{StaticResource CaptionText}" FontSize="13" Foreground="{StaticResource LanternBrush}" Margin="0,0,0,10"
                                       Visibility="{Binding HasProblem, Converter={StaticResource VisibleWhen}}" />
                            <Border x:Name="Status" Padding="12,8" CornerRadius="10" Margin="0,0,0,10" Background="{StaticResource ArcaneWashBrush}"
                                    BorderBrush="{StaticResource SoftVioletHairBrush}" BorderThickness="1" Visibility="{Binding Message, Converter={StaticResource VisibleWhen}}">
                                <TextBlock x:Name="StatusText" Text="{Binding Message}" FontSize="12.5" Foreground="{StaticResource VerdanceBrush}" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Text="{Binding EditLockText}" Style="{StaticResource CaptionText}" Margin="0,0,0,10" />

                            <StackPanel Visibility="{Binding HasDeliveries, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,12">
                                <TextBlock Text="WAITING FOR THE SERVER TO DELIVER" Style="{StaticResource KickerText}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Deliveries}" />
                            </StackPanel>

                            <TextBlock Text="IN THE INVENTORY" Style="{StaticResource KickerText}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Items}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Add items -->
                    <Border Grid.Column="2" Padding="16,14" CornerRadius="14" Background="{StaticResource CardGradientBrush}" BorderBrush="{StaticResource VioletHairBrush}" BorderThickness="1"
                            Margin="0,0,14,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Add items" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource StarlightBrush}" />
                                <Border Padding="10,8" CornerRadius="10" Margin="0,8,0,0" Background="{StaticResource LanternWashBrush}" BorderBrush="{StaticResource LanternHairBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="HOW NEW ITEMS ARRIVE" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource LanternBrush}" />
                                        <TextBlock Text="{Binding DeliveryExplanation}" FontSize="12" Foreground="{StaticResource SoftTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="17" />
                                        <TextBlock x:Name="DeliveryState" Text="{Binding DeliverySettingText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource VerdanceBrush}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="17" />
                                        <Button Style="{StaticResource LinkButton}" Content="Open that setting →" Command="{Binding ShowDeliverySettingCommand}" HorizontalAlignment="Left" Margin="-4,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,12,0,4">
                                <TextBox x:Name="ItemSearch" Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" AutomationProperties.Name="Search items" />
                                <TextBlock Text="⌕" Margin="11,0,0,1" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource LabelBrush}" IsHitTestVisible="False" />
                                <TextBlock Text="Search all items by name or ID…" Margin="31,0,0,0" VerticalAlignment="Center" FontSize="13" IsHitTestVisible="False" Foreground="{StaticResource DimLabelBrush}"
                                           Visibility="{Binding Text, ElementName=ItemSearch, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                            </Grid>
                            <TextBlock Grid.Row="2" Text="{Binding ResultsText}" FontSize="11.5" Foreground="{StaticResource DimLabelBrush}" Margin="2,0,0,4" />

                            <ListBox Grid.Row="3" MaxHeight="230" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0" CornerRadius="8" Padding="10,6" Margin="0,0,0,2">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverWashBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SelectedWashBrush}" />
                                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ArcaneBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource StarlightBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="11" Foreground="{StaticResource CaptionBrush}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Id, StringFormat=ID {0}  ·  , Mode=OneWay}" /><Run Text="{Binding Description, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="4" Margin="0,10,0,0" Visibility="{Binding HasSelection, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Text="{Binding Selected.Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource EmberBrush}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="AMOUNT" Style="{StaticResource KickerText}" />
                                        <TextBox Style="{StaticResource FieldTextBox}" Width="140" TextAlignment="Right" FontFamily="{StaticResource MonoFont}" Margin="0,3,0,0"
                                                 infra:NumericInput.ValueType="Int" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Amount" />
                                    </StackPanel>
                                    <StackPanel Margin="12,0,0,0" Visibility="{Binding CanEnchant, Converter={StaticResource VisibleWhen}}">
                                        <TextBlock Text="ENCHANT" Style="{StaticResource KickerText}" />
                                        <TextBox Style="{StaticResource FieldTextBox}" Width="80" TextAlignment="Right" FontFamily="{StaticResource MonoFont}" Margin="0,3,0,0"
                                                 infra:NumericInput.ValueType="Int" Text="{Binding EnchantText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Enchant level" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{Binding AddPlan}" FontSize="12" Foreground="{StaticResource SoftTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding AddPlan, Converter={StaticResource VisibleWhen}}" />
                                <TextBlock Text="{Binding AddProblem}" FontSize="12" Foreground="{StaticResource LanternBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding AddProblem, Converter={StaticResource VisibleWhen}}" />
                                <Button Style="{StaticResource PrimaryButton}" Content="{Binding AddButtonText}" Command="{Binding AddCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                            </StackPanel>
                        </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                    <Setter TargetName="Status" Property="Background" Value="{StaticResource LanternWashBrush}" />
                    <Setter TargetName="Status" Property="BorderBrush" Value="{StaticResource LanternHairBrush}" />
                    <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource LanternBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DeliveryDisabled}" Value="True">
                    <Setter TargetName="DeliveryState" Property="Foreground" Value="{StaticResource LanternBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Backups tab =================================================================== -->
        <DataTemplate DataType="{x:Type vm:BackupRowViewModel}">
            <Border Margin="0,0,14,10" Padding="18,14" CornerRadius="12" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource SoftVioletHairBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource StarlightBrush}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Badge}" Background="{StaticResource ArcaneWashBrush}" BorderBrush="#739D8CF0">
                                <TextBlock Text="{Binding KindWord}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ArcaneBrush}" />
                            </Border>
                        </WrapPanel>
                        <TextBlock FontSize="12" Foreground="{StaticResource CaptionBrush}" Margin="0,3,0,0">
                            <Run Text="{Binding When, Mode=OneWay}" /><Run Text="   ·   " /><Run Text="{Binding FolderName, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Changes}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource EmberBrush}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding MoreChanges}" FontSize="11.5" Foreground="{StaticResource DimLabelBrush}" Visibility="{Binding MoreChanges, Converter={StaticResource VisibleWhen}}" />
                        <ItemsControl ItemsSource="{Binding Contents}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource DimLabelBrush}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding BlockedReason}" FontSize="12" Foreground="{StaticResource LanternBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding BlockedReason, Converter={StaticResource VisibleWhen}}" />
                        <ItemsControl ItemsSource="{Binding Results}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="Result" Text="{Binding Message}" FontSize="12" Foreground="{StaticResource VerdanceBrush}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Ok}" Value="False">
                                            <Setter TargetName="Result" Property="Foreground" Value="{StaticResource LanternBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                        <Button Style="{StaticResource GhostButton}" Content="Restore…" Command="{Binding RestoreCommand}" Padding="16,6" FontSize="12.5" />
                        <Button Style="{StaticResource LinkButton}" Content="Open folder" Command="{Binding OpenFolderCommand}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== Full backups ================================================================== -->
        <DataTemplate DataType="{x:Type vm:FullBackupRowViewModel}">
            <Border Margin="0,0,14,10" Padding="18,14" CornerRadius="12" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource SoftVioletHairBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource StarlightBrush}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Badge}" Background="{StaticResource ArcaneWashBrush}" BorderBrush="#739D8CF0">
                                <TextBlock Text="{Binding VersionText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource ArcaneBrush}" />
                            </Border>
                        </WrapPanel>
                        <TextBlock FontSize="12" Foreground="{StaticResource CaptionBrush}" Margin="0,3,0,0" TextWrapping="Wrap">
                            <Run Text="{Binding When, Mode=OneWay}" /><Run Text="   ·   " /><Run Text="{Binding FolderName, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource DimLabelBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding UpdatedNotice}" FontSize="12.5" Foreground="{StaticResource EmberBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding UpdatedNotice, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                        <Button Style="{StaticResource GhostButton}" Content="Compare with now" Command="{Binding CompareCommand}" Padding="16,6" FontSize="12.5" />
                        <Button Style="{StaticResource LinkButton}" Content="Open folder" Command="{Binding OpenFolderCommand}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ComparisonHeading}">
            <StackPanel Margin="2,14,14,8">
                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource StarlightBrush}" />
                <Border Height="1" Margin="0,6,0,0" Background="{StaticResource SoftVioletHairBrush}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DifferenceRowViewModel}">
            <Border x:Name="Card" Margin="0,0,14,8" Padding="14,11" CornerRadius="12" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource SoftVioletHairBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" MinWidth="220" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource TickBox}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanRestore}" VerticalAlignment="Top" Margin="0,1,0,0"
                              AutomationProperties.Name="{Binding Name}" ToolTip="Tick to put this setting back to the value in the backup" />
                    <StackPanel Grid.Column="1">
                        <WrapPanel>
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource StarlightBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Border x:Name="KindBadge" Style="{StaticResource Badge}" Background="Transparent" BorderBrush="#4D7C6FB0">
                                <TextBlock x:Name="KindText" Text="{Binding KindWord}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource LabelBrush}" />
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Breadcrumb}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                        <Border CornerRadius="6" Background="#40100E22" BorderBrush="{StaticResource SoftVioletHairBrush}" BorderThickness="1" Padding="7,2" Margin="0,6,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Location}" Style="{StaticResource MonoChipText}" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <TextBlock Text="{Binding Reason}" FontSize="12" Foreground="{StaticResource DimLabelBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Reason, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                    <Grid Grid.Column="3" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125" />
                            <ColumnDefinition Width="125" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="IN THE BACKUP" Style="{StaticResource KickerText}" />
                            <TextBlock Text="{Binding BackupText}" FontFamily="{StaticResource MonoFont}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{StaticResource EmberBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="NOW" Style="{StaticResource KickerText}" />
                            <TextBlock Text="{Binding NowText}" FontFamily="{StaticResource MonoFont}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{StaticResource StarlightBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Visibility="{Binding ShippedText, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="L2EVERDREAM SHIPS" Style="{StaticResource KickerText}" />
                            <TextBlock Text="{Binding ShippedText}" FontFamily="{StaticResource MonoFont}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{StaticResource CaptionBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChangedFilter}" Value="True">
                    <Setter TargetName="KindBadge" Property="Background" Value="{StaticResource LanternWashBrush}" />
                    <Setter TargetName="KindBadge" Property="BorderBrush" Value="{StaticResource LanternHairBrush}" />
                    <Setter TargetName="KindText" Property="Foreground" Value="{StaticResource EmberBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsShippedChange}" Value="True">
                    <Setter TargetName="KindBadge" Property="Background" Value="{StaticResource ArcaneWashBrush}" />
                    <Setter TargetName="KindBadge" Property="BorderBrush" Value="#739D8CF0" />
                    <Setter TargetName="KindText" Property="Foreground" Value="{StaticResource ArcaneBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource ArcaneBrush}" />
                    <Setter TargetName="Card" Property="Background" Value="{StaticResource SelectedWashBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:FileDifferenceRowViewModel}">
            <Border x:Name="Card" Margin="0,0,14,8" Padding="14,11" CornerRadius="12" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource SoftVioletHairBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource TickBox}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanRestore}" VerticalAlignment="Top" Margin="0,1,0,0"
                              AutomationProperties.Name="{Binding Difference.FileLabel}" />
                    <StackPanel Grid.Column="1">
                        <WrapPanel>
                            <TextBlock Text="{Binding Difference.FileLabel}" FontFamily="{StaticResource MonoFont}" FontSize="13.5" Foreground="{StaticResource StarlightBrush}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Badge}" Background="{StaticResource LanternWashBrush}" BorderBrush="{StaticResource LanternHairBrush}">
                                <TextBlock Text="{Binding KindWord}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource EmberBrush}" />
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Reason}" FontSize="12" Foreground="{StaticResource DimLabelBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Reason, Converter={StaticResource VisibleWhen}}" />
                        <ItemsControl ItemsSource="{Binding Lines}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource SoftTextBrush}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding MoreLines}" FontSize="11.5" Foreground="{StaticResource DimLabelBrush}" Visibility="{Binding MoreLines, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource ArcaneBrush}" />
                    <Setter TargetName="Card" Property="Background" Value="{StaticResource SelectedWashBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ComparisonViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="2,0,24,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource GhostButton}" Content="← All full backups" Command="{Binding BackCommand}" Padding="12,6" FontSize="12" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource StarlightBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="Release" Text="{Binding ReleaseText}" FontSize="12.5" Foreground="{StaticResource CaptionBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SummaryText}" FontSize="12.5" Foreground="{StaticResource SoftTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="2,0,24,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <WrapPanel VerticalAlignment="Center">
                        <RadioButton Style="{StaticResource FilterRadio}" GroupName="CompareFilter" IsChecked="{Binding IsChangedFilter, Mode=OneWay}" Command="{Binding FilterCommand}" CommandParameter="changed"
                                     ToolTip="Settings whose value is different now from the backup">
                            <TextBlock Text="{Binding ChangedCount, StringFormat=Different from the backup ({0})}" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource FilterRadio}" GroupName="CompareFilter" IsChecked="{Binding IsShippedFilter, Mode=OneWay}" Command="{Binding FilterCommand}" CommandParameter="shipped"
                                     ToolTip="Your value is unchanged, but what L2Everdream ships for it changed">
                            <TextBlock Text="{Binding ShippedCount, StringFormat=Shipped defaults changed ({0})}" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource FilterRadio}" GroupName="CompareFilter" IsChecked="{Binding IsNewFilter, Mode=OneWay}" Command="{Binding FilterCommand}" CommandParameter="new"
                                     ToolTip="Settings that were not in the backup (usually added by an update)">
                            <TextBlock Text="{Binding NewCount, StringFormat=New since the backup ({0})}" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource FilterRadio}" GroupName="CompareFilter" IsChecked="{Binding IsAllFilter, Mode=OneWay}" Command="{Binding FilterCommand}" CommandParameter="all">
                            <TextBlock Text="{Binding AllCount, StringFormat=Everything ({0})}" />
                        </RadioButton>
                    </WrapPanel>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="CompareSearch" Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" AutomationProperties.Name="Search differences" />
                        <TextBlock Text="⌕" Margin="11,0,0,1" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource LabelBrush}" IsHitTestVisible="False" />
                        <TextBlock Text="Search settings or real names…" Margin="31,0,0,0" VerticalAlignment="Center" FontSize="13" IsHitTestVisible="False" Foreground="{StaticResource DimLabelBrush}"
                                   Visibility="{Binding Text, ElementName=CompareSearch, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                    </Grid>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="330" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,14,4">
                            <ItemsControl ItemsSource="{Binding Warnings}" Visibility="{Binding HasWarnings, Converter={StaticResource VisibleWhen}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource LanternBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Padding="12,8" CornerRadius="10" Background="{StaticResource ArcaneWashBrush}" BorderBrush="{StaticResource SoftVioletHairBrush}" BorderThickness="1" Margin="0,0,0,6"
                                    Visibility="{Binding CommentOnlyText, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Text="{Binding CommentOnlyText}" FontSize="12" Foreground="{StaticResource CaptionBrush}" TextWrapping="Wrap" LineHeight="17" />
                            </Border>
                        </StackPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource PlainListItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                 KeyboardNavigation.TabNavigation="Continue" Visibility="{Binding HasRows, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Grid.Row="1" Text="{Binding EmptyText}" Style="{StaticResource CaptionText}" FontSize="13.5" Margin="2,20,24,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasRows, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                    </Grid>

                    <Border Grid.Column="2" Padding="16,14" CornerRadius="14" Background="{StaticResource CardGradientBrush}" BorderBrush="{StaticResource VioletHairBrush}" BorderThickness="1" Margin="0,0,14,10"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Put settings back" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource StarlightBrush}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0" LineHeight="17" TextWrapping="Wrap"
                                       Text="Tick the settings you want back. Only those values are written — comments and settings added since the backup stay. Server settings are saved to both the install and the launcher's protected copy, and everything replaced is backed up first." />
                            <TextBlock Text="{Binding BlockedText}" FontSize="12" Foreground="{StaticResource LanternBrush}" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="17"
                                       Visibility="{Binding BlockedText, Converter={StaticResource VisibleWhen}}" />
                            <StackPanel Orientation="Horizontal" Margin="-4,8,0,0">
                                <Button Style="{StaticResource LinkButton}" Content="Tick all shown" Command="{Binding SelectAllCommand}" />
                                <Button Style="{StaticResource LinkButton}" Content="Clear" Command="{Binding ClearCommand}" />
                            </StackPanel>
                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding RestoreText}" Command="{Binding RestoreCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" Visibility="{Binding HasResults, Converter={StaticResource VisibleWhen}}">
                                <ItemsControl ItemsSource="{Binding Results}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="Result" Text="{Binding Message}" FontSize="12" Foreground="{StaticResource VerdanceBrush}" TextWrapping="Wrap" Margin="0,1,0,2" />
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Ok}" Value="False">
                                                    <Setter TargetName="Result" Property="Foreground" Value="{StaticResource LanternBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ReleaseChanged}" Value="True">
                    <Setter TargetName="Release" Property="Foreground" Value="{StaticResource EmberBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:FullBackupsViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Margin="2,0,24,12" Padding="16,12" CornerRadius="12" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource SoftVioletHairBrush}" BorderThickness="1"
                        Visibility="{Binding IsListVisible, Converter={StaticResource VisibleWhen}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FULL BACKUP FOLDER" Style="{StaticResource KickerText}" />
                            <TextBlock Text="{Binding FolderText}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{StaticResource SoftTextBrush}" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderText}" />
                            <TextBlock Text="{Binding FolderProblem}" FontSize="12" Foreground="{StaticResource LanternBrush}" Margin="0,3,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding FolderProblem, Converter={StaticResource VisibleWhen}}" />
                            <TextBlock Text="{Binding InstalledText}" FontSize="12" Foreground="{StaticResource DimLabelBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="Change folder…" Command="{Binding ChooseFolderCommand}" Padding="12,6" FontSize="12" Margin="0,0,8,0" />
                            <Button Style="{StaticResource GhostButton}" Content="Open folder" Command="{Binding OpenFolderCommand}" Padding="12,6" FontSize="12" Margin="0,0,12,0"
                                    Visibility="{Binding HasFolder, Converter={StaticResource VisibleWhen}}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Back up everything" Command="{Binding BackUpCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="2,0,24,10" Visibility="{Binding IsListVisible, Converter={StaticResource VisibleWhen}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource DimLabelBrush}" />
                        <TextBlock x:Name="Status" Text="{Binding Status}" FontSize="12.5" Foreground="{StaticResource VerdanceBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="{Binding Status, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="↻ Refresh" Command="{Binding RefreshCommand}" Padding="14,6" FontSize="12" />
                </Grid>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsListVisible, Converter={StaticResource VisibleWhen}}">
                    <ItemsControl ItemsSource="{Binding Rows}" />
                </ScrollViewer>
                <ContentControl Grid.RowSpan="3" Content="{Binding Comparison}" Focusable="False"
                                Visibility="{Binding IsListVisible, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                    <Setter TargetName="Status" Property="Foreground" Value="{StaticResource LanternBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BackupsViewModel}">
            <Grid Margin="24,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="2,0,24,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⟲" FontSize="22" Foreground="{StaticResource ArcaneBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource StarlightBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,4,0,0">
                            <RadioButton Style="{StaticResource FilterRadio}" GroupName="BackupMode" IsChecked="{Binding IsChangeMode, Mode=OneWay}"
                                         Command="{Binding ModeCommand}" CommandParameter="changes" Content="Change backups"
                                         ToolTip="Taken automatically before every save, character change and restore" />
                            <RadioButton Style="{StaticResource FilterRadio}" GroupName="BackupMode" IsChecked="{Binding IsFullMode, Mode=OneWay}"
                                         Command="{Binding ModeCommand}" CommandParameter="full" Content="Full backups"
                                         ToolTip="Everything at once — take one before updating L2Everdream, then compare and restore" />
