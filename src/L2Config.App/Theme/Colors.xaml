<!--
  The L2Everdream palette, ported from the launcher's launcher.css (the ".root" looked-up colours and the
  measured v12 theme) and the site's CSS variables. One home for every colour: never hex in a view.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="TwilightColor">#1B1636</Color>
    <Color x:Key="DeepColor">#12101F</Color>
    <Color x:Key="VoidColor">#0B0A18</Color>
    <Color x:Key="WispColor">#7C6FB0</Color>
    <Color x:Key="LanternColor">#E8A24C</Color>
    <Color x:Key="EmberColor">#F6C67A</Color>
    <Color x:Key="StarlightColor">#F4F1FA</Color>
    <Color x:Key="VerdanceColor">#8FB7A6</Color>
    <Color x:Key="ArcaneColor">#9D8CF0</Color>
    <Color x:Key="OnLanternColor">#2A1C07</Color>

    <SolidColorBrush x:Key="TwilightBrush" Color="{StaticResource TwilightColor}" />
    <SolidColorBrush x:Key="DeepBrush" Color="{StaticResource DeepColor}" />
    <SolidColorBrush x:Key="WispBrush" Color="{StaticResource WispColor}" />
    <SolidColorBrush x:Key="LanternBrush" Color="{StaticResource LanternColor}" />
    <SolidColorBrush x:Key="EmberBrush" Color="{StaticResource EmberColor}" />
    <SolidColorBrush x:Key="StarlightBrush" Color="{StaticResource StarlightColor}" />
    <SolidColorBrush x:Key="VerdanceBrush" Color="{StaticResource VerdanceColor}" />
    <SolidColorBrush x:Key="ArcaneBrush" Color="{StaticResource ArcaneColor}" />
    <SolidColorBrush x:Key="OnLanternBrush" Color="{StaticResource OnLanternColor}" />

    <!-- Secondary lavenders used for kickers, captions and descriptions -->
    <SolidColorBrush x:Key="LabelBrush" Color="#A99CD4" />
    <SolidColorBrush x:Key="CaptionBrush" Color="#9D90C8" />
    <SolidColorBrush x:Key="DimLabelBrush" Color="#8478B4" />
    <SolidColorBrush x:Key="SoftTextBrush" Color="#C9C2F2" />
    <SolidColorBrush x:Key="BodyTextBrush" Color="#B3A7D6" />

    <!-- Hairlines and fills (alpha values measured in launcher.css) -->
    <SolidColorBrush x:Key="HairBrush" Color="#477C6FB0" />
    <SolidColorBrush x:Key="VioletHairBrush" Color="#6B9D8CF0" />
    <SolidColorBrush x:Key="VioletHairHoverBrush" Color="#BF9D8CF0" />
    <SolidColorBrush x:Key="SoftVioletHairBrush" Color="#249D8CF0" />
    <SolidColorBrush x:Key="LanternHairBrush" Color="#73E8A24C" />
    <SolidColorBrush x:Key="CardBrush" Color="#572A2350" />
    <SolidColorBrush x:Key="FieldBrush" Color="#990C0A16" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#FB120F20" />
    <SolidColorBrush x:Key="BackdropBrush" Color="#9E06050C" />
    <SolidColorBrush x:Key="HoverWashBrush" Color="#0FF4F1FA" />
    <SolidColorBrush x:Key="SelectedWashBrush" Color="#2E9D8CF0" />
    <SolidColorBrush x:Key="ArcaneWashBrush" Color="#1A9D8CF0" />
    <SolidColorBrush x:Key="LanternWashBrush" Color="#1AE8A24C" />
    <SolidColorBrush x:Key="LanternWashStrongBrush" Color="#33E8A24C" />

    <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#8C2A2350" Offset="0" />
        <GradientStop Color="#991A1636" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource EmberColor}" Offset="0" />
        <GradientStop Color="{StaticResource LanternColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryGradientHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F9D293" Offset="0" />
        <GradientStop Color="#EDB066" Offset="1" />
    </LinearGradientBrush>

    <!-- The "dream" half of the wordmark -->
    <LinearGradientBrush x:Key="DreamGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#8F93F5" Offset="0" />
        <GradientStop Color="#8188FF" Offset="1" />
    </LinearGradientBrush>

    <!-- The launcher's window ground: twilight top fading to deep, with a violet glow at the top centre -->
    <LinearGradientBrush x:Key="WindowGroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource TwilightColor}" Offset="0" />
        <GradientStop Color="{StaticResource TwilightColor}" Offset="0.4" />
        <GradientStop Color="{StaticResource DeepColor}" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="WindowGlowBrush" Center="0.5,0.04" GradientOrigin="0.5,0.04" RadiusX="0.9" RadiusY="0.9">
        <GradientStop Color="#E6241D47" Offset="0" />
        <GradientStop Color="#00241D47" Offset="0.6" />
    </RadialGradientBrush>

    <FontFamily x:Key="DisplayFont">Georgia, Times New Roman</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Courier New</FontFamily>
</ResourceDictionary>
